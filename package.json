{
	"name": "yeonchamyeotgae",
	"private": true,
	"license": "MIT",
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"prepare": "husky",
		"verify": "turbo run lint typecheck test",
		"verify:product": "pnpm verify && pnpm test:product",
		"verify:workflows": "node scripts/verify-workflows.mjs",
		"build": "turbo run build",
		"dev": "pnpm --filter @yeoncha/desktop dev",
		"format": "biome check --write .",
		"lint": "turbo run lint",
		"test:product": "pnpm --filter @yeoncha/desktop test:product",
		"test:product:foreground": "pnpm --filter @yeoncha/desktop test:product:foreground",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"test:hooks": "node --test scripts/pre-push.test.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "~2.5.10",
		"husky": "9.1.7",
		"turbo": "^2.10.11",
		"typescript": "^7.0.2"
	}
}
